{:paths ["src" "resources"]
 :deps {io.millstrand/millstrand {:git/url "https://github.com/codethread/millstrand.git"
                                  :git/sha "310368dff9174bd889ad21d4ed8196952684eaf9"
                                  :deps/root "."}
        millhouse.spools/identity {:git/url "https://github.com/codethread/millhouse.spool.git"
